# Client-side. The only variable the bundle reads.
#
# 'true'  — resolve every request from src/api/fixtures.ts, no backend needed.
# unset   — call the service on the same origin: /api/ask and /api/health.
#
# There is deliberately no variable for an API host or port. The API is always
# same-origin: the Vite dev server proxies /api in development, nginx proxies it
# in the container. A base URL baked into the bundle is a cross-origin request
# waiting to happen.
#
VITE_USE_FIXTURES=true

# Server-side, development only (read by vite.config.ts, never by the bundle).
# Where the dev server forwards /api when VITE_USE_FIXTURES is not 'true'.
# In the container this same variable name is read by nginx — see
# docker-compose.frontend.yml, where it defaults to http://askai-api:8000.
#
# API_UPSTREAM=http://localhost:17900

# Caller identity, asserted server-side on the proxied request. Never sent by
# the browser: a client that can set it can forge it.
#
# CALLER_ID=askai-web
